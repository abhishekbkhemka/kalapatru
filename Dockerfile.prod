# Production API image — Gunicorn + WhiteNoise
# Does NOT bake in any database URL; pass DATABASE_URL / DATABASES_URL at runtime.
FROM python:3.11-slim-bookworm AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        default-libmysqlclient-dev \
        pkg-config \
        curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir mysqlclient

COPY . .

RUN chmod +x /app/docker/entrypoint.prod.sh \
    && mkdir -p /app/staticfiles /app/media

# Collectstatic needs Django settings; no real DB required for static only.
ENV SECRET_KEY=build-time-only \
    DEBUG=False \
    ALLOWED_HOSTS=* \
    DATABASE_URL=sqlite:///tmp/build.db

RUN python manage.py collectstatic --noinput

# Clear build-time DB URL so runtime MUST provide a real one
ENV DATABASE_URL= \
    SECRET_KEY=

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD curl -fsS http://127.0.0.1:${PORT:-8000}/ || exit 1

CMD ["sh", "/app/docker/entrypoint.prod.sh"]
