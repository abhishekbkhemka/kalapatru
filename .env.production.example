# =============================================================================
# STAGING / NEW SERVER ONLY
# Do NOT point DATABASE_URL at your current production RDS until cutover.
# =============================================================================
# cp .env.production.example .env.production
# docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# =============================================================================

# Required — NEW MySQL (or use --profile with-db and the values below)
DATABASE_URL=mysql://kalapatru:CHANGE_ME@db:3306/kalapatru_staging

SECRET_KEY=generate-a-long-random-string-here
DEBUG=False
ALLOWED_HOSTS=your-api-host.example.com,localhost
CSRF_TRUSTED_ORIGINS=https://your-api-host.example.com,https://your-web-host.example.com
CORS_ALLOWED_ORIGINS=https://your-web-host.example.com
FRONTEND_URL=https://your-web-host.example.com

# First deploy only — then set to false
BOOTSTRAP_ADMIN=true
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=change-this-password

WEB_CONCURRENCY=3
PORT=8000
API_PORT=8000
WEB_PORT=80

# Public API URL baked into the React build (browser-facing)
VITE_API_BASE_URL=https://your-api-host.example.com

# Only needed with: --profile with-db
MYSQL_DATABASE=kalapatru_staging
MYSQL_USER=kalapatru
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_PORT=3306
